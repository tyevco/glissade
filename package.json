{
  "name": "glissade-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:browser": "node scripts/build-browser.mjs && node scripts/build-browser-dom.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:bundle": "node scripts/check-bundle-integrity.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:api": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "check:docs-api": "node scripts/gen-api-docs.mjs --check",
    "check:readme": "node scripts/check-readme-subpaths.mjs",
    "check:describe": "node scripts/check-describe.mjs",
    "lint": "eslint packages/core/src packages/scene/src"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@glissade/eslint-plugin": "workspace:*",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^25.9.2",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "0.28.0",
    "eslint": "^9.0.0",
    "playwright": "^1.60.0",
    "tsdown": "0.12.9",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.3"
  }
}
