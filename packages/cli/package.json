{
  "name": "@glissade/cli",
  "version": "0.55.0-pre.1",
  "description": "glissade CLI: headless rendering via backend-skia (+ FFmpeg mux).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "bin": {
    "gs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glissade/backend-skia": "workspace:*",
    "@glissade/core": "workspace:*",
    "@glissade/interact": "workspace:*",
    "@glissade/lottie": "workspace:*",
    "@glissade/narrate": "workspace:*",
    "@glissade/player": "workspace:*",
    "@glissade/scene": "workspace:*",
    "@glissade/sfx": "workspace:*",
    "@glissade/svg": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.65",
    "esbuild": "0.28.0",
    "jiti": "^2.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyevco/glissade.git",
    "directory": "packages/cli"
  }
}
