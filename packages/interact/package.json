  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glissade/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyevco/glissade.git",
    "directory": "packages/interact"
  }
}
