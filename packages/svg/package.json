{
  "name": "@glissade/svg",
  "version": "0.17.1-pre.0",
  "description": "glissade SVG import: parse an SVG into a deterministic scene module — <path d> and the basic shapes become Path/Rect/Circle nodes with fills, strokes, and transforms.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glissade/core": "workspace:*",
    "@glissade/scene": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyevco/glissade.git",
    "directory": "packages/svg"
  }
}
