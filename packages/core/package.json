{
  "name": "@glissade/core",
  "version": "0.51.0",
  "description": "glissade core: signals, tracks, timeline document, evaluation, easing, springs, seeded RNG. Zero DOM/Node dependencies.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": [
    "./dist/expr.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./studio-host": {
      "types": "./dist/studioHost.d.ts",
      "default": "./dist/studioHost.js"
    },
    "./clips": {
      "types": "./dist/clips.d.ts",
      "default": "./dist/clips.js"
    },
    "./expr": {
      "types": "./dist/expr.d.ts",
      "default": "./dist/expr.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar.d.ts",
      "default": "./dist/sidecar.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./font-ingest": {
      "types": "./dist/font-ingest.d.ts",
      "default": "./dist/font-ingest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyevco/glissade.git",
    "directory": "packages/core"
  },
  "optionalDependencies": {
    "fontverter": "^2.0.0",
    "subset-font": "^2.5.0"
  }
}
