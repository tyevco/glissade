{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "test"],
  // studio-e2e.test.ts is a cross-package browser integration test (playwright +
  // the studio's own vite config from the workspace root); vitest transpiles and
  // runs it, but it is outside this package's tsc scope.
  "exclude": ["test/studio-e2e.test.ts"]
}
